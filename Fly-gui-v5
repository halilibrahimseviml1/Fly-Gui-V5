-- Webhook Gönderme Fonksiyonu (AYNI)
SendFeedbackBtn.MouseButton1Click:Connect(function()
    local text = FeedbackBox.Text
    if text and text ~= "" and text ~= "Please report your suggestions and bugs" then
        if requestFunc then
            local data = {
                ["content"] = "",
                ["embeds"] = {{
                    ["title"] = "Lightning Hub - Feedback / Bug Report",
                    ["description"] = text,
                    ["color"] = 16776960,
                    ["fields"] = {
                        {["name"] = "Player", ["value"] = player.Name .. " (" .. player.UserId .. ")", ["inline"] = true}
                    },
                    ["footer"] = {["text"] = "Lightning Hub Universal Fly"}
                }}
            }
            pcall(function()
                requestFunc({
                    Url = webhookUrl,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(data)
                })
            end)
            SendFeedbackBtn.Text = "Sent Successfully!"
            FeedbackBox.Text = ""
            task.delay(2, function()
                SendFeedbackBtn.Text = "Send Feedback"
            end)
        else
            SendFeedbackBtn.Text = "Executor not supported!"
            task.delay(2, function()
                SendFeedbackBtn.Text = "Send Feedback"
            end)
        end
    else
        SendFeedbackBtn.Text = "Please enter text!"
        task.delay(2, function()
            SendFeedbackBtn.Text = "Send Feedback"
        end)
    end
end)

