-- [ DEĞİŞMEYEN UÇUŞ MOTORU ] --
FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    FlyBtn.Text = flying and "FLY: ON" or "FLY: OFF"
    
    -- Görsel güncelleme (değişken renk)
    if flying then
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
        FlyBtn.TextColor3 = Color3.new(0, 0, 0)
        flyGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 210, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 140, 200))
        })
    else
        FlyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        FlyBtn.TextColor3 = Color3.new(1, 1, 1)
        flyGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 70, 90)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(35, 35, 50))
        })
    end

    if flying then
        task.spawn(function()
            local char = player.Character or player.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            local hum = char:WaitForChild("Humanoid")

            local bv = Instance.new("BodyVelocity", root)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.new(0, 0, 0)

            local bg = Instance.new("BodyGyro", root)
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 15000 

            while flying and char.Parent and hum.Health > 0 do
                runService.Heartbeat:Wait()
                local moveDir = hum.MoveDirection 
                if moveDir.Magnitude > 0 then
                    local camLook = camera.CFrame.LookVector
                    local verticalVelocity = 0
                    if moveDir.Unit:Dot(camera.CFrame.LookVector.Unit) > 0.5 then
                        verticalVelocity = camLook.Y * flySpeed
                    elseif moveDir.Unit:Dot(camera.CFrame.LookVector.Unit) < -0.5 then
                        verticalVelocity = -camLook.Y * flySpeed
                    end
                    bv.Velocity = Vector3.new(moveDir.X * flySpeed, verticalVelocity, moveDir.Z * flySpeed)
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                bg.CFrame = camera.CFrame
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end)
    end
end)
